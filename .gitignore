# Unity project is located in /Project Soulbound/
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
/Project Soulbound/.utmp/
/Project Soulbound/[Ll]ibrary/
/Project Soulbound/[Tt]emp/
/Project Soulbound/[Oo]bj/
/Project Soulbound/[Bb]uild/
/Project Soulbound/[Bb]uilds/
/Project Soulbound/[Ll]ogs/
/Project Soulbound/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Project Soulbound/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Project Soulbound/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Project Soulbound/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Project Soulbound/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/Project Soulbound/ExportedObj/
/Project Soulbound/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/Project Soulbound/ServerData
/Project Soulbound/[Aa]ssets/StreamingAssets/aa*
/Project Soulbound/[Aa]ssets/AddressableAssetsData/link.xml*
/Project Soulbound/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Project Soulbound/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/Project Soulbound/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Project Soulbound/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Project Soulbound/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Project Soulbound/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/Project Soulbound/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/Project Soulbound/UIElementsSchema/

# Auto-generated cache in Assets folder
/Project Soulbound/[Aa]ssets/[Ss]ceneDependencyCache*

# Local IDE state (shared VS Code settings remain trackable)
.idea/
.vscode/.browse.VC.db*
.vscode/ipch/
.history/
*.sln.docstates

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Editor backup files
*~
*.swp
*.swo

# Unity diagnostics and generated capture folder metadata
/Project Soulbound/[Cc]rashReports/
/Project Soulbound/[Cc]rashReports.meta
/Project Soulbound/[Mm]emoryCaptures.meta
/Project Soulbound/[Rr]ecordings.meta

# Generated build folders outside the nested Unity project
/[Bb]uild/
/[Bb]uilds/
